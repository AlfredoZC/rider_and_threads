        <mxCell id="variante_a-100" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Configuramos 2 variables nuevas: la probabilidad de que un pedido sea urgente y cuanto puede esperar un pedido normal antes de volverse urgente (envejecer)." vertex="1">
