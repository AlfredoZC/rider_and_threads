        <mxCell id="variante_a-106" parent="waJ1P5KGZcp9GQDQEJrR-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="El libro elige el siguiente pedido: primero los urgentes y los normales que ya esperaron demasiado (envejecidos), despues los normales; entre iguales el mas antiguo y si empatan el id menor. Tambien calcula cuando vence o envejece el proximo pedido, y no asigna un pedido que ya vencio." vertex="1">
          <mxGeometry height="150" width="400" x="14" y="2380" as="geometry" />
        </mxCell>
